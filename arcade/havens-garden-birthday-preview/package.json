{
  "name": "havens-garden-birthday-preview",
  "private": true,
  "version": "0.9.0",
  "description": "Haven's Garden birthday preview — hardening tests + evidence",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
